function initRoiCanvas() {
    const canvas = document.getElementById("roi-canvas");
    const img = document.getElementById("live-stream-img");
    if (!canvas || !img) return;

    function resizeCanvas() {
        canvas.width = img.clientWidth;
        canvas.height = img.clientHeight;
        drawPolygon();
    }

    img.onload = resizeCanvas;
    window.addEventListener("resize", resizeCanvas);
    setTimeout(resizeCanvas, 500);

    canvas.addEventListener("click", function(e) {
        const rect = canvas.getBoundingClientRect();
        const normX = parseFloat(((e.clientX - rect.left) / canvas.width).toFixed(3));
        const normY = parseFloat(((e.clientY - rect.top) / canvas.height).toFixed(3));

        if (roiPoints.length >= 4) {
            roiPoints = [];
        }
        roiPoints.push([normX, normY]);
        drawPolygon();
    });
}

function drawPolygon() {
    const canvas = document.getElementById("roi-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    if (roiPoints.length === 0) return;

    ctx.strokeStyle = "#38bdf8";
    ctx.fillStyle = "rgba(56, 189, 248, 0.25)";
    ctx.lineWidth = 2;

    ctx.beginPath();
    for (let i = 0; i < roiPoints.length; i++) {
        const px = roiPoints[i][0] * canvas.width;
        const py = roiPoints[i][1] * canvas.height;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);

        // Draw anchor dot
        ctx.fillStyle = "#f59e0b";
        ctx.fillRect(px - 4, py - 4, 8, 8);
        ctx.fillStyle = "rgba(56, 189, 248, 0.25)";
    }

    if (roiPoints.length >= 3) {
        ctx.closePath();
        ctx.fill();
    }
    ctx.stroke();
}

function resetRoiPoints() {
    roiPoints = [];
    drawPolygon();
}

function saveRoiPoints() {
    if (roiPoints.length < 3) {
        alert("Please click at least 3 or 4 points to form a zone boundary.");
        return;
    }
    fetch(`/api/cameras/${currentCamId}/roi`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ roi: roiPoints })
    })
    .then(r => r.json())
    .then(data => {
        alert("Monitoring zone saved successfully!");
    })
    .catch(err => {
        alert("Failed to save monitoring zone.");
        console.error(err);
    });
}

document.addEventListener("DOMContentLoaded", initRoiCanvas);
</script>

